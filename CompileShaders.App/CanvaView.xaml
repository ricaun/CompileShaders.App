<Window x:Class="CompileShaders.App.CanvaView"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CompileShaders.App"
        xmlns:effect="clr-namespace:CompileShaders.App.ShaderEffects"
        mc:Ignorable="d">

    <StackPanel Margin="0">
        <Canvas x:Name="MainCanvas"
                Height="640"
                Width="640"
                Background="#f0f0f0">
            <Canvas.Effect>
                <effect:InvertHueEffect />
            </Canvas.Effect>

            <Rectangle Width="16"
                       Height="16">
                <Rectangle.Fill>
                    <DrawingBrush Stretch="None">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <DrawingGroup.ClipGeometry>
                                    <RectangleGeometry Rect="0,0,16,16" />
                                </DrawingGroup.ClipGeometry>
                                <GeometryDrawing Brush="#FFFFFF00">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="0,12,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF808000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="0,8,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FFFF0000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="0,4,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF800000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="0,0,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF00FFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="4,12,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF008080">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="4,8,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF00FF00">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="4,4,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF008000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="4,0,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FFFF00FF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="8,12,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF800080">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="8,8,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF0000FF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="8,4,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF000080">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="8,0,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FFFFFFFF">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="12,12,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FFCCCCCC">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="12,8,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF333333">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="12,4,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#FF000000">
                                    <GeometryDrawing.Geometry>
                                        <RectangleGeometry RadiusX="0"
                                                           RadiusY="0"
                                                           Rect="12,0,4,4" />
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>

            <!-- Box -->
            <Rectangle Width="200"
                       Height="200"
                       Fill="DarkBlue"
                       Stroke="Black"
                       StrokeThickness="4"
                       Canvas.Left="80"
                       Canvas.Top="80" />

            <!-- Box -->
            <Rectangle Width="200"
                       Height="200"
                       Fill="DarkGreen"
                       Stroke="Black"
                       StrokeThickness="4"
                       Canvas.Left="80"
                       Canvas.Top="360" />

            <!-- Circle -->
            <Ellipse Width="200"
                     Height="200"
                     Fill="DarkCyan"
                     Stroke="Black"
                     StrokeThickness="4"
                     Canvas.Left="360"
                     Canvas.Top="80" />

            <!-- Circle -->
            <Ellipse Width="200"
                     Height="200"
                     Fill="DarkRed"
                     Stroke="Black"
                     StrokeThickness="4"
                     Canvas.Left="360"
                     Canvas.Top="360" />

        </Canvas>
        <StackPanel Orientation="Horizontal" Background="Gray">
            <Image Source="16.png">
                <Image.Effect>
                    <effect:InvertHueEffect />
                </Image.Effect>
            </Image>
            <Image Source="16.png"
                   Height="128">
                <Image.Effect>
                    <effect:InvertHueEffect />
                </Image.Effect>
            </Image>
            <Image Source="16.png">
                <Image.Effect>
                    <effect:TransformLuminosityEffect />
                </Image.Effect>
            </Image>
            <Image Source="16.png"
                   Height="128">
                <Image.Effect>
                    <effect:TransformLuminosityEffect />
                </Image.Effect>
            </Image>
            <Image Source="16.png"
                   Height="128">
            </Image>
        </StackPanel>
    </StackPanel>
</Window>
